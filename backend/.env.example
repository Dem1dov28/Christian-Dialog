# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/epochaldialog

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP Configuration for Reports
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
REPORT_SENDER_EMAIL=your-email@gmail.com
REPORT_SENDER_PASSWORD=your-app-password
REPORT_RECIPIENT_EMAIL=admin@yoursite.com

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# API Keys (optional)
OPENROUTER_API_KEY=your-openrouter-api-key
GOOGLE_CLIENT_ID=your-google-client-id

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/*,application/pdf,text/plain

# Logging
LOG_LEVEL=INFO