# =============================================================================
# Epochal Dialog — один .env для backend, frontend и Docker Compose
# Скопируйте в .env и подставьте свои значения. Файл .env не коммитить.
# =============================================================================

# --- PostgreSQL (Docker Compose; для локального запуска backend — см. DATABASE_URL ниже) ---
DB_NAME=timetalk
DB_USER=timetalk_user
DB_PASSWORD=задайте_надёжный_пароль

# --- Backend: обязательно ---
SECRET_KEY=сгенерируйте_64_символа_python_c_import_secrets_print_secrets_token_urlsafe_64
DATABASE_URL=postgresql://timetalk_user:пароль@localhost:5432/timetalk
REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

OPENROUTER_API_KEY=sk-or-v1-...
GOOGLE_CLIENT_ID=ваш_client_id.apps.googleusercontent.com
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Backend: опционально ---
DEBUG=True
PORT=8000
# OPENTRIPMAP_API_KEY=...   # для достопримечательностей

# CryptoCloud PAY (крипто-платежи): https://app.cryptocloud.plus
# Создать проект → взять SHOP_ID, API KEY, SECRET KEY
# Notification URL в ЛК: https://epochaldialog.com/payments/cryptocloud/callback
# Successful URL: https://epochaldialog.com/successful-payment
# Failed URL:     https://epochaldialog.com/failed-payment
# CRYPTOCLOUD_API_KEY=
# CRYPTOCLOUD_SHOP_ID=
# CRYPTOCLOUD_SECRET_KEY=
# CRYPTOCLOUD_PRICE_PLUS=2
# CRYPTOCLOUD_PRICE_PRO=5

# BePaid (подписки): BEPAID_SHOP_ID, BEPAID_SECRET_KEY, BEPAID_PLAN_PLUS_ID, BEPAID_PLAN_PRO_ID, BEPAID_BACKEND_BASE
# Email отчётов: SMTP_SERVER, SMTP_PORT, REPORT_SENDER_EMAIL, REPORT_SENDER_PASSWORD, REPORT_RECIPIENT_EMAIL

# --- Frontend (Vite; при сборке для продакшена задайте VITE_API_BASE_URL под домен) ---
# ВАЖНО: для production с HTTPS используйте https:// — иначе Mixed Content
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=ваш_client_id.apps.googleusercontent.com
# VITE_DEV_SERVER_HOST=localhost
# VITE_DEV_SERVER_PORT=5173
# VITE_API_TIMEOUT=30000

# --- pgAdmin (только при запуске с профилем development: docker compose --profile development up) ---
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=задайте_пароль
