# Пример переменных окружения для docker-compose (корень проекта).
# Скопируйте в .env и подставьте реальные значения. Файл .env не коммитить.
# Команда: cp env.example .env  (или copy env.example .env на Windows)

# PostgreSQL (обязательно)
DB_NAME=timetalk
DB_USER=timetalk_user
DB_PASSWORD=задайте_сложный_пароль

# pgAdmin (только при запуске с профилем development: docker compose --profile development up)
PGADMIN_EMAIL=admin@yourdomain.local
PGADMIN_PASSWORD=задайте_сложный_пароль
